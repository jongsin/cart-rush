# ─────────────────────────────────────────────
# CART RUSH — .gitignore (Node.js / Express / ws)
# ─────────────────────────────────────────────

# Dependencies
node_modules/
.npm/
jspm_packages/

# 주의: package-lock.json 은 커밋합니다 (Dockerfile 의 npm ci 가 사용)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / process
pids/
*.pid
*.seed
*.pid.lock

# 환경 변수 / 시크릿
.env
.env.*
!.env.example

# 테스트 / 커버리지
coverage/
*.lcov
.nyc_output/

# 캐시
.cache/
.eslintcache
.parcel-cache/
*.tsbuildinfo

# OS 생성 파일
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 에디터 / IDE
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# Claude Code (개인 로컬 설정만 무시, 공유 설정은 커밋)
.claude/settings.local.json

# CodeGraph (로컬 인덱스 DB 는 무시, config 는 공유)
.codegraph/codegraph.db
.codegraph/*.db-shm
.codegraph/*.db-wal

# 임시 파일
tmp/
temp/
*.tmp
